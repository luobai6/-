# Auto detect text files and perform LF normalization
* text=auto

# Unity serialized assets and shared source files
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.json text eol=lf
/README.md text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf

# Bundled Unity packages must remain byte-for-byte intact
*.tgz binary
